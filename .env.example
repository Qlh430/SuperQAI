PORT=3199
OUTBOUND_PROXY_URL=auto
OUTBOUND_NO_PROXY=localhost,127.0.0.1,::1,.local
MAX_REQUEST_MB=30
MAX_MEDIA_UPLOAD_MB=800
CANVAS_STORAGE_MODE=auto
CANVAS_DB_FILE=./data/canvas.db
AI_API_URL=https://ai.t8star.cn/v1/chat/completions
AI_API_KEY=在这里填写你的APIKey
AI_MODEL=gpt-4o-mini
AI_MODELS=gpt-4o-mini,gpt-4o,gpt-3.5-turbo
CANVAS_AGENT_API_URL=https://api.openai.com/v1/responses
CANVAS_AGENT_API_KEY=your-openai-agent-key
CANVAS_AGENT_MODEL=gpt-5.6-sol
CANVAS_AGENT_REASONING_EFFORT=medium
CANVAS_AGENT_TIMEOUT_SECONDS=180
CANVAS_AGENT_CONNECT_TIMEOUT_SECONDS=4
CANVAS_AGENT_FIRST_EVENT_TIMEOUT_SECONDS=30
CANVAS_AGENT_ATTEMPT_TIMEOUT_SECONDS=45
CANVAS_AGENT_TOTAL_TIMEOUT_SECONDS=90
CANVAS_AGENT_USE_SETTINGS_PROVIDERS=true
CANVAS_AGENT_ROUTE_HISTORY_ENABLED=true
# Optional absolute path for 功能 Skill（用户自建/导入）。系统 Skill 固定随应用部署在 ./skills。
AI_OS_SKILLS_DIR=./data/skills
GEMINI_API_URL=https://ai.t8star.org/v1/chat/completions
GEMINI_API_KEY=your-gemini-chat-key
GEMINI_MODELS=gemini-3-pro-preview
BAILIAN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
BAILIAN_API_KEY=your-aliyun-bailian-key
BAILIAN_MODELS=qwen3.6-plus,qwen3.6-max-preview,qwen3.6-flash,deepseek-v4-flash
AI_IMAGE_API_URL=https://ai.t8star.cn/v1/images/generations
AI_IMAGE_EDIT_API_URL=https://ai.t8star.cn/v1/images/edits
AI_IMAGE_CHAT_API_URL=https://ai.t8star.org/v1/chat/completions
AI_IMAGE_CHAT_API_KEY=your-gemini-image-chat-key
AI_IMAGE_MODEL=gpt-image-1
AI_IMAGE_MODELS=gpt-image-1
IMAGE_JOB_TIMEOUT_MINUTES=15
GRSAI_IMAGE_FETCH_TIMEOUT_SECONDS=180
APIMART_IMAGE_API_KEY=your-apimart-key
MIDJOURNEY_IMAGE_API_URL=https://api.apimart.ai/v1/midjourney/generations
MIDJOURNEY_IMAGE_TASK_API_URL=https://api.apimart.ai/v1/tasks
COMFYUI_URL=http://192.168.1.53:8188

# 本地 AI 抠图（BEN2 Base，约 213MB）。权重随应用内置在 ./assets/models/background-removal，开箱即用。
# 只有想改用别处的权重时才需要填，填了它优先于内置权重（不会复制副本）：
# AI_OS_BACKGROUND_REMOVAL_MODEL_PATH=F:\DXOS-Portable-0.2.0-win-x64\data\models\background-removal\ben2-base-1.0.0.onnx
# 内置权重被删掉/改坏时可以用它指向另一份权重目录，工作台也会给出“导入本地模型”的兜底入口：
# AI_OS_BACKGROUND_REMOVAL_BUNDLED_DIR=
# 模型更新默认对着 Prama LLC 的官方仓库检查并下载。国内连不上 huggingface.co 时可以换成镜像：
# AI_OS_BACKGROUND_REMOVAL_UPSTREAM_URL=https://hf-mirror.com/api/models/PramaLLC/BEN2/tree/main
# AI_OS_BACKGROUND_REMOVAL_UPSTREAM_META_URL=https://hf-mirror.com/api/models/PramaLLC/BEN2
# AI_OS_BACKGROUND_REMOVAL_DOWNLOAD_URL=https://hf-mirror.com/PramaLLC/BEN2/resolve/main/BEN2_Base.onnx

# Optional absolute path to the official local Dreamina CLI.
# JIMENG_BIN and DREAMINA_BIN are used only when this value is unset.
AI_OS_JIMENG_BIN=

# 服务端组件解耦：可选组件被停用/缺失时不再拖垮整个进程，只让对应接口返回 503。
# 逗号分隔组件 id，例如：AI_OS_DISABLED_SERVER_COMPONENTS=thumbnail-http-api,background-removal-http-api
# 主干组件（认证、静态资源、系统健康、偏好设置、Provider/模型底座）不允许停用。
# 运行期可通过 GET /api/system/components 查看每个组件的 required/依赖/status。
AI_OS_DISABLED_SERVER_COMPONENTS=
